{
  "root": "./root",
  "allow_access_base_dir_up_level": false,

  "server": { "enabled": true, "host": "0.0.0.0", "port": 80, "debug": false },

  "webdav": { "enabled": true, "mount": "/dav" },

  "database": { "url": "sqlite:///./users.db" },

  "auth": {
    "enabled": true,
    "realm": "StaticFileServer",
    "anonymous_readonly": true,
    "initial_user": { "username": "admin", "password": "admin", "permissions": "rw" }
  },

  "access": {
    "enabled": false,
    "whitelist": [],
    "blacklist": [],
    "trust_proxy_headers": true
  },

  "log": { "level": "INFO", "file": "" }
}
